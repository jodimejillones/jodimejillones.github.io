<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Juan Manuel Serrano · Ciberseguridad</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg:        #0a0e0a;
      --surface:   #0f140f;
      --card:      #131a13;
      --border:    #1f2e1f;
      --green:     #00ff88;
      --green-dim: #00cc6a;
      --green-muted: #1a4d33;
      --text:      #d4e8d4;
      --muted:     #5a7a5a;
      --mono:      'Share Tech Mono', monospace;
      --sans:      'Inter', sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      font-size: 15px;
      line-height: 1.7;
      overflow-x: hidden;
    }
    body::before {
      content: '';
      position: fixed; inset: 0;
      background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,255,136,0.015) 2px, rgba(0,255,136,0.015) 4px);
      pointer-events: none;
      z-index: 9999;
    }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      background: rgba(10,14,10,0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
      z-index: 100;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
    }
    .nav-logo { font-family: var(--mono); color: var(--green); font-size: 0.9rem; letter-spacing: 0.05em; }
    .nav-logo span { color: var(--muted); }
    nav ul { list-style: none; display: flex; gap: 1.6rem; }
    nav ul a { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); text-decoration: none; letter-spacing: 0.08em; transition: color 0.2s; }
    nav ul a:hover { color: var(--green); }

    /* HERO */
    #hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 80px 2rem 4rem;
      position: relative;
      overflow: hidden;
    }
    .hero-grid {
      position: absolute; inset: 0;
      background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 60px 60px;
      opacity: 0.4;
    }
    .hero-glow {
      position: absolute;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(0,255,136,0.07) 0%, transparent 70%);
      top: 50%; left: 50%;
      transform: translate(-50%, -60%);
      pointer-events: none;
    }
    .hero-content { position: relative; max-width: 860px; margin: 0 auto; }
    .hero-eyebrow {
      font-family: var(--mono); font-size: 0.78rem; color: var(--green);
      letter-spacing: 0.15em; margin-bottom: 1.2rem;
      display: flex; align-items: center; gap: 0.6rem;
    }
    .hero-eyebrow::before { content: ''; display: inline-block; width: 28px; height: 1px; background: var(--green); }
    .hero-name { font-family: var(--sans); font-size: clamp(2.8rem, 7vw, 5.5rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; color: #fff; margin-bottom: 0.3rem; }
    .hero-name .accent { color: var(--green); }
    .hero-title { font-family: var(--mono); font-size: clamp(1rem, 2.5vw, 1.4rem); color: var(--muted); margin-bottom: 1.8rem; }
    .cursor { display: inline-block; width: 10px; height: 1.1em; background: var(--green); vertical-align: text-bottom; animation: blink 1s step-end infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    .hero-desc { font-size: 1rem; color: var(--text); max-width: 580px; margin-bottom: 2.5rem; opacity: 0.85; }
    .hero-links { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
    .btn { font-family: var(--mono); font-size: 0.82rem; letter-spacing: 0.08em; padding: 0.65rem 1.4rem; border-radius: 2px; text-decoration: none; transition: all 0.2s; cursor: pointer; }
    .btn-primary { background: var(--green); color: #000; border: 1px solid var(--green); font-weight: 700; }
    .btn-primary:hover { background: transparent; color: var(--green); }
    .btn-outline { background: transparent; color: var(--green); border: 1px solid var(--green-muted); }
    .btn-outline:hover { border-color: var(--green); background: rgba(0,255,136,0.05); }

    /* SECTIONS */
    section { padding: 6rem 2rem; max-width: 960px; margin: 0 auto; }
    .section-label { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.18em; color: var(--green); margin-bottom: 0.5rem; }
    .section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 700; color: #fff; margin-bottom: 3rem; position: relative; padding-bottom: 1rem; }
    .section-title::after { content: ''; position: absolute; bottom: 0; left: 0; width: 48px; height: 2px; background: var(--green); }

    /* TIMELINE */
    .timeline { position: relative; padding-left: 2rem; }
    .timeline::before { content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 1px; background: linear-gradient(to bottom, var(--green), var(--green-muted), transparent); }
    .tl-item { position: relative; margin-bottom: 3rem; }
    .tl-item::before { content: ''; position: absolute; left: -2.35rem; top: 8px; width: 10px; height: 10px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px var(--green); }
    .tl-date { font-family: var(--mono); font-size: 0.72rem; color: var(--green); letter-spacing: 0.1em; margin-bottom: 0.3rem; }
    .tl-role { font-size: 1.05rem; font-weight: 600; color: #fff; margin-bottom: 0.15rem; }
    .tl-company { font-size: 0.88rem; color: var(--muted); margin-bottom: 0.8rem; font-family: var(--mono); }
    .tl-bullets { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; }
    .tl-bullets li { font-size: 0.9rem; color: var(--text); opacity: 0.8; padding-left: 1.2rem; position: relative; }
    .tl-bullets li::before { content: '▸'; position: absolute; left: 0; color: var(--green); font-size: 0.75rem; }

    /* SKILLS */
    .skills-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
    .skill-card { background: var(--card); border: 1px solid var(--border); border-radius: 4px; padding: 1.2rem 1.4rem; transition: border-color 0.2s, box-shadow 0.2s; }
    .skill-card:hover { border-color: var(--green-muted); box-shadow: 0 0 16px rgba(0,255,136,0.06); }
    .skill-cat { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; color: var(--green); margin-bottom: 0.6rem; }
    .skill-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .tag { font-family: var(--mono); font-size: 0.72rem; background: var(--green-muted); color: var(--green); padding: 0.2rem 0.55rem; border-radius: 2px; letter-spacing: 0.04em; }

    /* CERTIFICACIONES */
    .certs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.4rem; }
    .cert-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
      text-decoration: none;
      display: block;
      position: relative;
    }
    .cert-card:hover {
      border-color: var(--green);
      transform: translateY(-3px);
      box-shadow: 0 8px 32px rgba(0,255,136,0.1);
    }
    .cert-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--green), transparent);
    }
    .cert-img-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      overflow: hidden;
      background: #0d1a0d;
      cursor: pointer;
    }
    .cert-img-wrap img {
      width: 100%; height: 100%;
      object-fit: cover;
      filter: grayscale(20%) brightness(0.85);
      transition: filter 0.3s, transform 0.3s;
    }
    .cert-card:hover .cert-img-wrap img { filter: grayscale(0%) brightness(1); transform: scale(1.03); }
    .cert-overlay {
      position: absolute; inset: 0;
      background: rgba(0,255,136,0.08);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.3s;
    }
    .cert-card:hover .cert-overlay { opacity: 1; }
    .cert-overlay span {
      font-family: var(--mono); font-size: 0.8rem; color: var(--green);
      border: 1px solid var(--green); padding: 0.4rem 1rem; border-radius: 2px;
      background: rgba(0,0,0,0.6);
    }
    .cert-body { padding: 1.2rem 1.4rem; }
    .cert-issuer { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em; color: var(--green); margin-bottom: 0.4rem; }
    .cert-name { font-size: 1rem; font-weight: 600; color: #fff; margin-bottom: 0.3rem; }
    .cert-date { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); margin-bottom: 0.8rem; }
    .cert-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }

    /* Placeholder para certs futuras */
    .cert-placeholder {
      background: transparent;
      border: 1px dashed var(--border);
      border-radius: 6px;
      padding: 2.5rem 1.4rem;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 0.6rem; text-align: center;
      opacity: 0.5;
    }
    .cert-placeholder span:first-child { font-size: 1.8rem; }
    .cert-placeholder span:last-child { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }

    /* CTF */
    .ctf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.2rem; }
    .ctf-card { background: var(--card); border: 1px solid var(--border); border-radius: 4px; padding: 1.4rem; position: relative; overflow: hidden; transition: border-color 0.2s, transform 0.2s; }
    .ctf-card:hover { border-color: var(--green-muted); transform: translateY(-2px); }
    .ctf-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--green), transparent); }
    .ctf-platform { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em; color: var(--green); margin-bottom: 0.5rem; }
    .ctf-title { font-size: 1rem; font-weight: 600; color: #fff; margin-bottom: 0.5rem; }
    .ctf-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.6; margin-bottom: 1rem; }
    .ctf-link { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--mono); font-size: 0.75rem; color: var(--green); text-decoration: none; margin-top: 1rem; opacity: 0.85; transition: opacity 0.2s; }
    .ctf-link:hover { opacity: 1; }

    /* EDU */
    .edu-list { display: flex; flex-direction: column; gap: 1.5rem; }
    .edu-card { background: var(--card); border: 1px solid var(--border); border-radius: 4px; padding: 1.4rem 1.6rem; display: grid; grid-template-columns: 1fr auto; gap: 0.5rem 1rem; align-items: start; }
    .edu-title { font-size: 1rem; font-weight: 600; color: #fff; grid-column: 1; }
    .edu-school { font-family: var(--mono); font-size: 0.78rem; color: var(--green); grid-column: 1; }
    .edu-date { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); grid-column: 2; grid-row: 1 / 3; text-align: right; white-space: nowrap; }
    .edu-modules { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.6rem; }

    /* CONTACTO */
    #contacto { padding: 6rem 2rem; }
    .contact-inner { max-width: 960px; margin: 0 auto; }
    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 3rem; }
    .contact-info p { font-size: 0.95rem; color: var(--text); opacity: 0.8; margin-bottom: 2rem; }
    .contact-links { display: flex; flex-direction: column; gap: 0.8rem; }
    .contact-link { display: flex; align-items: center; gap: 0.8rem; font-family: var(--mono); font-size: 0.82rem; color: var(--text); text-decoration: none; opacity: 0.75; transition: opacity 0.2s, color 0.2s; }
    .contact-link:hover { opacity: 1; color: var(--green); }
    .contact-icon { width: 32px; height: 32px; border: 1px solid var(--border); border-radius: 2px; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0; background: var(--card); }
    .contact-form { display: flex; flex-direction: column; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
    .form-group label { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.1em; color: var(--green); }
    .form-group input, .form-group textarea { background: var(--card); border: 1px solid var(--border); border-radius: 2px; color: var(--text); font-family: var(--mono); font-size: 0.85rem; padding: 0.7rem 1rem; outline: none; transition: border-color 0.2s; resize: none; }
    .form-group input:focus, .form-group textarea:focus { border-color: var(--green-muted); }
    .form-group textarea { min-height: 120px; }
    .form-submit { font-family: var(--mono); font-size: 0.82rem; letter-spacing: 0.08em; padding: 0.75rem 1.6rem; background: var(--green); color: #000; border: none; border-radius: 2px; font-weight: 700; cursor: pointer; transition: all 0.2s; align-self: flex-start; }
    .form-submit:hover { background: transparent; color: var(--green); border: 1px solid var(--green); }

    /* FOOTER */
    footer { border-top: 1px solid var(--border); padding: 2rem; text-align: center; font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
    footer span { color: var(--green); }

    /* ANIMATIONS */
    .fade-in { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .fade-in.visible { opacity: 1; transform: none; }

    @media (max-width: 680px) {
      nav ul { display: none; }
      .contact-grid { grid-template-columns: 1fr; }
      .edu-card { grid-template-columns: 1fr; }
      .edu-date { grid-row: auto; text-align: left; }
    }
  </style>
</head>
